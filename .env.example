# Local persistence for the deterministic fixture and evidence.
CLEANBREAK_DATABASE_PATH=./data/cleanbreak.db
CLEANBREAK_DRY_RUN=true
CLEANBREAK_BASE_URL=http://localhost:3000
# Solari runs remotely, so this must be a public tunnel or deployed URL.
CLEANBREAK_PUBLIC_BASE_URL=https://your-public-host.example

# Keep browser credentials and configuration server-side.
SOLARI_API_KEY=
SOLARI_PROFILE_ID=
SOLARI_PROFILE_NAME=cleanbreak-demo
SOLARI_STEALTH=false
SOLARI_RECORDING=true
SOLARI_PERSIST_PROFILE_STATE=true
SOLARI_NAVIGATION_TIMEOUT_MS=30000

# Keep planning credentials server-side.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
CLEANBREAK_AGENT_MAX_STEPS=20
CLEANBREAK_AGENT_MIN_CONFIDENCE=0.70

# Real-provider validation is opt-in, dry-run only, and requires an account you own or control.
# CLEANBREAK_REAL_PROVIDER_AUTHORIZED=true
# CLEANBREAK_REAL_PROVIDER_NAME=Example Provider
# CLEANBREAK_REAL_PROVIDER_URL=https://provider.example/account/subscription
# CLEANBREAK_REAL_PROVIDER_PLAN_NAME=Individual
# CLEANBREAK_REAL_PROVIDER_AMOUNT_CENTS=999
# CLEANBREAK_REAL_PROVIDER_CURRENCY=USD
# CLEANBREAK_REAL_PROVIDER_INTERVAL=MONTHLY
# CLEANBREAK_REAL_PROVIDER_NEXT_RENEWAL=2026-10-01
