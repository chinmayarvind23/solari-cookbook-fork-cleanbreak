# Milestone 1 stores the deterministic fixture in this local SQLite file.
CLEANBREAK_DATABASE_PATH=./data/cleanbreak.db
CLEANBREAK_BASE_URL=http://localhost:3000
# Solari runs remotely, so this must be a public tunnel or deployed URL.
CLEANBREAK_PUBLIC_BASE_URL=https://your-public-host.example

# Added in Milestone 2. Keep these values server-side.
SOLARI_API_KEY=
SOLARI_PROFILE_ID=
SOLARI_PROFILE_NAME=cleanbreak-demo
SOLARI_STEALTH=false
SOLARI_RECORDING=true
SOLARI_PERSIST_PROFILE_STATE=true
SOLARI_NAVIGATION_TIMEOUT_MS=30000
