{
  "name": "solari-cleanbreak-ts",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "secret:audit": "node --env-file-if-exists=../../.env --import tsx scripts/secret-audit.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "solari:smoke": "node --conditions react-server --env-file-if-exists=../../.env --import tsx scripts/solari-smoke.ts",
    "agent:smoke": "node --conditions react-server --env-file-if-exists=../../.env --import tsx scripts/agent-smoke.ts"
  },
  "dependencies": {
    "@solarisdk/browser": "0.1.3",
    "chromium-bidi": "0.4.33",
    "next": "16.3.4",
    "openai": "^7.9.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "prettier": "3.9.6",
    "tsx": "^4.20.5",
    "typescript": "^5.9.3",
    "vitest": "4.1.11"
  }
}
